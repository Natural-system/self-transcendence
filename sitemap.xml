---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% for post in site.posts %}
    {% unless post.sitemap == false %}
    <url>
      <loc>{{ post.url | absolute_url | xml_escape }}</loc>
      <lastmod>{{ post.date | date_to_xmlschema }}</lastmod>
    </url>
    {% endunless %}
  {% endfor %}

  {% for page in site.html_pages %}
    {% unless page.sitemap == false or page.url contains "404" %}
    <url>
      <loc>{{ page.url | absolute_url | xml_escape }}</loc>
      {% if page.last_modified_at %}
      <lastmod>{{ page.last_modified_at | date_to_xmlschema }}</lastmod>
      {% endif %}
    </url>
    {% endunless %}
  {% endfor %}

  {% for log in site.logs %}
    {% unless log.sitemap == false %}
    <url>
      <loc>{{ log.url | absolute_url | xml_escape }}</loc>
    </url>
    {% endunless %}
  {% endfor %}
</urlset>